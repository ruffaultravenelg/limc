Imports System.IO

Namespace CodeGen
    Module Handler

        Private Consts As New HashSet(Of CodeGen.Const)
        Private GlobalVariables As New HashSet(Of CodeGen.GlobalVariable)
        Private Enums As New HashSet(Of CodeGen.Enum)
        Private Structs As New HashSet(Of CodeGen.Struct)
        Private Functions As New HashSet(Of CodeGen.Function)

        Public Sub RegisterConst([Const] As CodeGen.Const)
            Consts.Add([Const])
        End Sub

        Public Sub RegisterGlobalVariable(GlobalVariable As CodeGen.GlobalVariable)
            GlobalVariables.Add(GlobalVariable)
        End Sub

        Public Sub RegisterEnum([Enum] As CodeGen.Enum)
            Enums.Add([Enum])
        End Sub

        Public Sub RegisterStruct(Struct As CodeGen.Struct)
            Structs.Add(Struct)
        End Sub

        Public Sub RegisterFunction([Function] As CodeGen.Function)
            Functions.Add([Function])
        End Sub

        Public Sub AssembleFile(Filepath As String)

            'Create file
            Dim Writer As New StreamWriter(Filepath)

            'Write header
            Writer.WriteLine("/*")
            Writer.WriteLine(vbTab & "This file was auto-generated by the Lim compiler.")
            Writer.WriteLine(vbTab & "Developed by Gémino Ruffault--Ravenel.")
            Writer.WriteLine("*/")

            'Close file writer
            Writer.Close()

        End Sub

    End Module
End Namespace